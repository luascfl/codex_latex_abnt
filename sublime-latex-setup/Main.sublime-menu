[
    {
        "caption": "Preferences",
        "mnemonic": "n",
        "id": "preferences",
        "children": [
            {
                "caption": "Package Settings",
                "mnemonic": "P",
                "id": "package-settings",
                "children": [
                    {
                        "caption": "Latex Build On Window Blur",
                        "children": [
                            {
                                "caption": "Settings",
                                "command": "edit_settings",
                                "args": {
                                    "base_file": "${packages}/Latex Build On Window Blur/LatexBuildOnWindowBlur.sublime-settings",
                                    "default": "{\n    \"enabled\": true,\n    \"selector\": \"text.tex.latex\",\n    \"extensions\": [\".tex\"],\n    \"save_all_dirty_views\": true,\n    \"build_delay_ms\": 300\n}\n"
                                }
                            }
                        ]
                    }
                ]
            }
        ]
    }
]
